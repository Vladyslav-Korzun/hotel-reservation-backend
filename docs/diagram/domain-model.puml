  BackgroundColor<<Res>>       #FCE4EC
  BorderColor<<Res>>           #C62828
  BackgroundColor<<Stay>>      #E3F2FD
  BorderColor<<Stay>>          #1565C0
  BackgroundColor<<Service>>   #F3E5F5
  BorderColor<<Service>>       #6A1B9A
  BackgroundColor<<Audit>>     #EFEBE9
  BorderColor<<Audit>>         #4E342E
  BackgroundColor<<Shared>>    #E0F2F1
  BorderColor<<Shared>>        #00695C
  BackgroundColor<<Port>>      #E8EAF6
  BorderColor<<Port>>          #283593
  ArrowColor                   #444444
}

skinparam package {
  BackgroundColor<<Guest>>     #FFF8F0
  BorderColor<<Guest>>         #E65100
  BackgroundColor<<Hotel>>     #FFFDE7
  BorderColor<<Hotel>>         #F9A825
  BackgroundColor<<Room>>      #F1F8E9
  BorderColor<<Room>>          #388E3C
  BackgroundColor<<Res>>       #FFF0F3
  BorderColor<<Res>>           #C62828
  BackgroundColor<<Stay>>      #EBF5FB
  BorderColor<<Stay>>          #1565C0
  BackgroundColor<<Service>>   #F9F0FF
  BorderColor<<Service>>       #6A1B9A
