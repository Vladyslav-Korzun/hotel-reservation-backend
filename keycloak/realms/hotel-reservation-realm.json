          "config": {
            "user.attribute": "guest_id",
            "claim.name": "guest_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
